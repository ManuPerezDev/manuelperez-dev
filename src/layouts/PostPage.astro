---
// A blog post in one language. Rendered by src/pages/blog/[slug].astro (es) and src/pages/en/blog/[slug].astro (en).
import { getImage, Image } from 'astro:assets'
import { render } from 'astro:content'
import Icon from '../components/Icon.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { getPosts, hasTranslation } from '../data/posts'
import { homePath, languages, postPath, useTranslations } from '../i18n'
import { formatLongDate } from '../utils/dates'
import BaseLayout from './BaseLayout.astro'

const { post, lang } = Astro.props
const t = useTranslations(lang)
const { Content } = await render(post)
const {
  title,
  description,
  date,
  slug,
  hero_image: heroImage,
  hero_image_alt: heroImageAlt,
  hero_image_owner_url: heroImageOwnerUrl
} = post.data
const ogImage = await getImage({ src: heroImage, format: 'jpg', width: 1200 })

const paths = {}
for (const code of Object.keys(languages)) {
  if (await hasTranslation(code, slug)) paths[code] = postPath(code, slug)
}
const alternates = Object.entries(paths).map(([code, href]) => ({ lang: code, href }))
const articlesLink = `${homePath(lang)}#${t.sectionIds.articles}`

// Neighbours in the same list the home shows (newest first; on /en/ untranslated posts fall back to Spanish)
const posts = await getPosts(lang)
const index = posts.findIndex(entry => entry.post.data.slug === slug)
const neighbours = [
  { entry: posts[index + 1], label: t.olderPost, icon: 'tabler:arrow-left', align: 'left' },
  { entry: posts[index - 1], label: t.newerPost, icon: 'tabler:arrow-right', align: 'right' }
]
---

<BaseLayout
  lang={lang}
  seo={{
    title,
    description,
    image: new URL(ogImage.src, Astro.site).href,
    type: 'article',
    publishedTime: date.toISOString(),
    alternates: alternates.length > 1 ? alternates : []
  }}
>
  <div class='mx-auto min-h-screen max-w-3xl px-6 py-10 md:px-12 md:py-16'>
    <header class='flex flex-wrap items-center justify-between gap-4'>
      <a href={articlesLink} class='group inline-flex items-center gap-2 font-mono text-sm text-accent'>
        <Icon name='tabler:arrow-left' size='1.1em' class='transition-transform group-hover:-translate-x-1 motion-reduce:transition-none' />
        Manuel Pérez
      </a>
      <div class='flex items-center gap-4'>
        <ThemeToggle lang={lang} />
        {Object.keys(paths).length > 1 && <LanguageSwitcher lang={lang} paths={paths} />}
      </div>
    </header>

    <main class='mt-10'>
      <article>
        <p class='font-mono text-sm text-ink-faint'>
          <time datetime={date.toISOString().slice(0, 10)}>{formatLongDate(date, t.dateLocale)}</time>
        </p>
        <h1 class='mt-3 font-display text-3xl leading-tight font-semibold tracking-tight text-balance text-ink sm:text-4xl'>{title}</h1>

        <figure class='mt-8'>
          <Image
            src={heroImage}
            alt={heroImageAlt}
            width={1200}
            widths={[400, 800, 1200]}
            sizes='(max-width: 768px) 100vw, 720px'
            loading='eager'
            class='aspect-video w-full rounded-lg border border-line object-cover'
          />
          {
            heroImageOwnerUrl && (
              <figcaption class='mt-2 font-mono text-xs text-ink-faint'>
                {t.photo}: <a href={heroImageOwnerUrl} class='underline hover:text-accent'>Unsplash</a>
              </figcaption>
            )
          }
        </figure>

        <div class='post-body mt-10'>
          <Content />
        </div>
      </article>
    </main>

    <footer class='mt-16 border-t border-line pt-8'>
      <nav aria-label={t.morePosts} class='grid gap-8 sm:grid-cols-2 sm:gap-6'>
        {
          neighbours.map(({ entry, label, icon, align }) =>
            entry ? (
              <a
                href={postPath(entry.lang, entry.post.data.slug)}
                hreflang={entry.lang}
                class:list={['group flex flex-col gap-1', align === 'right' && 'sm:col-start-2 sm:items-end sm:text-right']}
              >
                <span class:list={['inline-flex items-center gap-1.5 font-mono text-xs text-ink-faint', align === 'right' && 'flex-row-reverse']}>
                  <Icon
                    name={icon}
                    size='1.1em'
                    class:list={[
                      'transition-transform motion-reduce:transition-none',
                      align === 'right' ? 'group-hover:translate-x-1' : 'group-hover:-translate-x-1'
                    ]}
                  />
                  {label}
                  {entry.lang !== lang && t.inSpanish && <span class='rounded-md bg-accent-soft px-1.5 text-accent-ink'>{t.inSpanish}</span>}
                </span>
                <span class='leading-snug font-medium text-balance text-ink group-hover:text-accent' lang={entry.lang === lang ? undefined : entry.lang}>
                  {entry.post.data.title}
                </span>
              </a>
            ) : null
          )
        }
      </nav>
      <a href={articlesLink} class='mt-10 inline-flex items-center gap-2 font-mono text-sm text-ink-faint hover:text-accent'>
        <Icon name='tabler:list' />
        {t.backToArticles}
      </a>
    </footer>
  </div>
</BaseLayout>
