---
// Content section of the home page. The title is a mono header row ("// 01. TITLE", the prefix hidden from screen readers).
// On mobile the sticky MobileNav bar names the current section.
const { id, title, index } = Astro.props
const number = String(index).padStart(2, '0')
---

<section id={id} aria-labelledby={`${id}-title`} class='mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24'>
  <div class='mb-8 flex items-center border-b border-line pb-3'>
    <h2 id={`${id}-title`} class='font-mono text-sm font-semibold tracking-wide text-accent uppercase'><span aria-hidden='true'>{`// ${number}. `}</span>{title}</h2>
  </div>
  <slot />
</section>
