---
import { profile } from '../data/profile'
import { cvPath, homePath, useTranslations } from '../i18n'
import Icon from './Icon.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ThemeToggle from './ThemeToggle.astro'

const { lang, sections } = Astro.props
const t = useTranslations(lang)
---

<header class='lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/3 lg:flex-col lg:justify-between lg:py-24'>
  <div>
    <h1 class='font-display text-3xl leading-tight font-semibold tracking-tight text-ink sm:text-4xl'>
      <a href={homePath(lang)}>Manuel Pérez</a>
    </h1>
    <p class='mt-3 font-mono text-sm'>
      <span class='text-accent'>Product Developer</span>
      <span class='mx-1 text-ink-faint'>·</span>
      <span class='text-ink-faint'>{profile.location[lang]}</span>
    </p>
    <p class='mt-4 max-w-xs text-ink-muted'>{t.tagline}</p>

    <nav aria-label={t.sectionsLabel} class='hidden lg:block'>
      <ul class='mt-16 flex w-max flex-col'>
        {
          sections.map(section => (
            <li>
              <a
                href={`#${section.id}`}
                data-nav-link
                class='group flex items-center gap-3 border-l-2 border-transparent py-2 pr-4 pl-4 transition-colors hover:border-ink-faint aria-[current=true]:border-accent'
              >
                <span class='font-mono text-sm text-ink-muted group-hover:text-ink group-aria-[current=true]:text-accent'>{section.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class='mt-6 lg:mt-8 lg:border-t lg:border-line lg:pt-6'>
    <div class='flex items-center gap-6 lg:block'>
      <a
        href={cvPath(lang)}
        download={`manuel-perez-cv-${lang}.pdf`}
        class='inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-line bg-surface px-4 font-mono text-sm text-ink transition-colors hover:border-accent hover:text-accent lg:flex lg:w-full lg:py-3'
      >
        <Icon name='tabler:download' size='1.2em' />
        {t.downloadCv}
      </a>
      <div class='flex items-center gap-5 lg:hidden'>
        <a
          href={profile.links.github}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`GitHub ${t.newTab}`}
          class='-m-2.5 p-2.5 text-ink-faint transition-colors hover:text-accent'
        >
          <Icon name='tabler:brand-github' size='22' />
        </a>
        <a
          href={profile.links.linkedin}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`LinkedIn ${t.newTab}`}
          class='-m-2.5 p-2.5 text-ink-faint transition-colors hover:text-accent'
        >
          <Icon name='tabler:brand-linkedin' size='22' />
        </a>
      </div>
    </div>
    <div class='mt-5 hidden items-center justify-between gap-4 lg:flex'>
      <div class='flex items-center gap-5'>
        <a
          href={profile.links.github}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`GitHub ${t.newTab}`}
          class='-m-2.5 p-2.5 text-ink-faint transition-colors hover:text-accent'
        >
          <Icon name='tabler:brand-github' size='22' />
        </a>
        <a
          href={profile.links.linkedin}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`LinkedIn ${t.newTab}`}
          class='-m-2.5 p-2.5 text-ink-faint transition-colors hover:text-accent'
        >
          <Icon name='tabler:brand-linkedin' size='22' />
        </a>
      </div>
      <div class='flex items-center gap-2'>
        <LanguageSwitcher lang={lang} />
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </div>
</header>

<script>
  // Marks the nav link of the current section: the last one whose top has passed 30% of the viewport.
  // The first section wins at the top of the page and the last one at the bottom.
  const links = [...document.querySelectorAll('[data-nav-link]')]
  const sections = links.map(link => document.getElementById(link.hash.slice(1))).filter(Boolean)
  let scheduled = false

  const update = () => {
    scheduled = false
    const threshold = window.innerHeight * 0.3
    let current = sections[0]
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= threshold) current = section
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
    if (atBottom) current = sections.at(-1)
    for (const link of links) link.setAttribute('aria-current', String(link.hash.slice(1) === current?.id))
  }

  const schedule = () => {
    if (scheduled) return
    scheduled = true
    requestAnimationFrame(update)
  }

  window.addEventListener('scroll', schedule, { passive: true })
  window.addEventListener('resize', schedule)
  update()
</script>
